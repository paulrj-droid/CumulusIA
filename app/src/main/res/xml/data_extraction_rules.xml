<?xml version="1.0" encoding="utf-8"?>
<!--
    💾 Copia de seguridad (Android 12 o más nuevo).
    cloud-backup: copia en tu cuenta de Google (máximo 25 MB). Sin modelos, voces, descargas ni imágenes pesadas.
    device-transfer: al pasar a un teléfono nuevo con cable o Wi-Fi. Pasan también tus imágenes y avatares,
    pero no los modelos (varios GB; se vuelven a descargar).
    Las claves de la IA en la nube nunca se copian: van cifradas con una llave que solo existe en este teléfono.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="Download" />
        <exclude domain="external" path="tts_voices" />
        <exclude domain="file" path="image_ai" />
        <exclude domain="file" path="espeak-ng-data" />
        <exclude domain="file" path="espeak-ng-data.ok" />
        <exclude domain="file" path="chat_images" />
        <exclude domain="file" path="chat_media" />
        <exclude domain="file" path="entregas" />
        <exclude domain="file" path="avatar_lib" />
        <exclude domain="sharedpref" path="CumulusCloudAi.xml" />
        <exclude domain="sharedpref" path="geniex_guard.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" path="Download" />
        <exclude domain="external" path="tts_voices" />
        <exclude domain="file" path="image_ai" />
        <exclude domain="file" path="espeak-ng-data" />
        <exclude domain="file" path="espeak-ng-data.ok" />
        <exclude domain="sharedpref" path="CumulusCloudAi.xml" />
        <exclude domain="sharedpref" path="geniex_guard.xml" />
    </device-transfer>
</data-extraction-rules>
