<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_download_panel_tts"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:orientation="vertical"
    android:background="@drawable/bg_card_dark"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_download_title_tts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Descargando..."
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_download_status_tts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Preparando descarga..."
        android:textColor="#808080"
        android:textSize="13sp"
        android:layout_marginTop="6dp" />

    <ProgressBar
        android:id="@+id/progress_download_tts"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="0"
        android:progressTint="#3D5AFE"
        android:progressBackgroundTint="#171719"
        android:layout_marginTop="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btn_pause_tts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="â¸ Pausar"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2C2C2E"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_resume_tts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="â–¶ Reanudar"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3949AB"
            android:enabled="false"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_delete_tts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ðŸ—‘ Eliminar"
            android:textColor="#FFFFFF"
            android:backgroundTint="#C62828" />
    </LinearLayout>
</LinearLayout>
