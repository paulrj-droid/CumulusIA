<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <!-- PANTALLA PRINCIPAL (CHAT) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <ImageButton
                android:id="@+id/btn_open_left_drawer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_rounded_button"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="#FFFFFF" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_ai_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cumulus IA"
                android:maxLength="10"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_open_right_drawer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_rounded_button"
                android:src="@android:drawable/ic_menu_preferences"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_chat_messages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="20dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/chat_composer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_input"
            android:minHeight="56dp"
            android:padding="8dp"
            android:layout_marginBottom="0dp"
            android:layout_marginTop="8dp">

            <!-- 📎 Adjuntos: miniaturas con su X (hasta 10 imágenes, 10 archivos, 5 videos) -->
            <HorizontalScrollView
                android:id="@+id/attachments_scroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:visibility="gone"
                android:layout_marginTop="2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:id="@+id/attachments_strip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp" />
            </HorizontalScrollView>

            <!-- Texto arriba, ocupa todo el ancho -->
            <EditText
                android:id="@+id/et_chat_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:background="@null"
                android:hint="Pregúntame..."
                android:textColor="#FFFFFF"
                android:textColorHint="#808080"
                android:textSize="16sp"
                android:gravity="top|start"
                android:paddingHorizontal="6dp"
                android:paddingVertical="8dp"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="6"
                android:scrollbars="vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/attachments_scroll"
                app:layout_constraintBottom_toTopOf="@id/btn_voice_play_pause" />

            <!-- Fila de botones abajo: ▶  +  [Modo]  🎤  ➤ -->
            <ImageButton
                android:id="@+id/btn_voice_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@null"
                android:src="@android:drawable/ic_media_play"
                app:tint="#808080"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/et_chat_input"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageButton
                android:id="@+id/btn_attach"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@null"
                android:src="@android:drawable/ic_input_add"
                app:tint="#808080"
                app:layout_constraintStart_toEndOf="@id/btn_voice_play_pause"
                app:layout_constraintTop_toTopOf="@id/btn_voice_play_pause"
                app:layout_constraintBottom_toBottomOf="@id/btn_voice_play_pause" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_chat_mode"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="8dp"
                android:text="Solo chat ▴"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:singleLine="true"
                android:ellipsize="end"
                app:strokeColor="#808080"
                app:cornerRadius="20dp"
                android:layout_marginHorizontal="6dp"
                app:layout_constraintStart_toEndOf="@id/btn_attach"
                app:layout_constraintEnd_toStartOf="@id/btn_mic"
                app:layout_constraintTop_toTopOf="@id/btn_voice_play_pause"
                app:layout_constraintBottom_toBottomOf="@id/btn_voice_play_pause" />

            <ImageButton
                android:id="@+id/btn_mic"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@null"
                android:src="@drawable/ic_mic"
                app:tint="#808080"
                app:layout_constraintEnd_toStartOf="@id/btn_send"
                app:layout_constraintTop_toTopOf="@id/btn_voice_play_pause"
                app:layout_constraintBottom_toBottomOf="@id/btn_voice_play_pause" />

            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_blue"
                android:src="@android:drawable/ic_menu_send"
                app:tint="#FFFFFF"
                android:layout_marginStart="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/btn_voice_play_pause"
                app:layout_constraintBottom_toBottomOf="@id/btn_voice_play_pause" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <!-- PANEL IZQUIERDO (SERVICIOS Y CONTROL) -->
    <ScrollView
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#1C1C1E">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SERVICIOS Y CONTROL"
                android:textColor="#00E676"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IMAGEN DEL CHAT"
                android:textColor="#3D5AFE"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_restore_chat_image"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Restablecer predeterminada"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:backgroundTint="#2C2C2E"
                    app:cornerRadius="8dp"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_choose_bubble_image"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Elegir personalizada"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:backgroundTint="#3D5AFE"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_choose_voices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Voces guardadas" 
                android:textColor="#FFFFFF"
                android:backgroundTint="#2C2C2E"
                app:cornerRadius="8dp"
                android:layout_marginBottom="10dp" />




            <!-- ==================== ELEVENLABS ==================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ELEVENLABS"
                android:textColor="#3D5AFE"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_eleven_api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_rounded"
                android:hint="API Key"
                android:padding="10dp"
                android:inputType="textPassword"
                android:textColor="#FFFFFF"
                android:textColorHint="#808080"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_eleven_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Guardar API Key"
                android:textColor="#FFFFFF"
                android:backgroundTint="#3D5AFE"
                app:cornerRadius="8dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_eleven_record"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Grabar"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2C2C2E"
                    app:cornerRadius="8dp"
                    android:layout_marginEnd="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_eleven_test"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Probar"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2C2C2E"
                    app:cornerRadius="8dp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_eleven_use"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Usar"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#3D5AFE"
                    app:cornerRadius="8dp"
                    android:layout_marginEnd="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_eleven_delete"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Eliminar"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#C62828"
                    app:cornerRadius="8dp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_eleven_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Guardar"
                android:textColor="#FFFFFF"
                android:backgroundTint="#3D5AFE"
                app:cornerRadius="8dp"
                android:layout_marginBottom="16dp" />

            <!-- 🌓 Modo claro / oscuro -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="APARIENCIA"
                android:textColor="#3D5AFE"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌙 Modo oscuro"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:checked="true"
                app:thumbTint="#3D5AFE"
                app:trackTint="#555555"
                android:layout_marginBottom="16dp" />
        </LinearLayout>
    </ScrollView>

    <!-- PANEL DERECHO (CONFIGURACIÓN) -->
    <LinearLayout
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#1C1C1E">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
             android:text="CONFIGURACIÓN PRINCIPAL"
            android:textColor="#3D5AFE"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="12dp" />

         <TextView
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:text="Motor IA, personalidad, nombres e idiomas"
             android:textColor="#8A8A93"
             android:textSize="12sp"
             android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_gguf_downloads"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                    android:text="MODELOS GGUF / LITERT-LM"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:backgroundTint="#3D5AFE"
                app:cornerRadius="10dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_tts_downloads"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="VOCES TTS"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:backgroundTint="#2C2C2E"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <ViewFlipper
            android:id="@+id/settings_page_flipper"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:animateFirstView="false">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="40dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_model_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nombre del modelo"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2C2C2E"
                    app:cornerRadius="12dp"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mmproj"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="mmproj"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2C2C2E"
                    app:cornerRadius="12dp"
                    android:layout_marginBottom="10dp" />

                <Spinner
                    android:id="@+id/spinner_backend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_rounded"
                    android:padding="10dp"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_backend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:text="CPU / GPU / NPU"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2C2C2E"
                    app:cornerRadius="12dp"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_load_model"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cargar modelo"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#3D5AFE"
                    app:cornerRadius="12dp"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_auto_load"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Carga automática"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:checked="true"
                    app:thumbTint="#3D5AFE"
                    app:trackTint="#555555"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tv_model_loaded_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Modelo: Ninguno"
                    android:textColor="#808080"
                    android:textSize="12sp"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONFIGURACIÓN DEL MODELO"
                    android:textColor="#3D5AFE"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONTEXTO"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seek_context"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="8192"
                    android:progress="2048" />

                <TextView
                    android:id="@+id/tv_context_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2048 tok"
                    android:textColor="#808080"
                    android:textSize="11sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TEMPERATURA"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seek_temperature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50" />

                <TextView
                    android:id="@+id/tv_temperature_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.5"
                    android:textColor="#808080"
                    android:textSize="11sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOP K"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seek_top_k"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="30" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOP P"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seek_top_p"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PERSONALIDAD PERSONALIZADA"
                    android:textColor="#3D5AFE"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/et_personality_custom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="Escribe tu personalidad..."
                    android:padding="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#808080"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="5"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_delete_custom_personality"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Borrar"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#C62828"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save_custom_personality"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Guardar"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#3D5AFE"
                        app:cornerRadius="8dp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONFIGURACIÓN DE NOMBRES"
                    android:textColor="#3D5AFE"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/et_ai_name_custom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="Nombre de la IA (máx. 10)"
                    android:maxLength="10"
                    android:singleLine="true"
                    android:padding="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#808080"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_delete_ai_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Eliminar"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#C62828"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save_ai_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Guardar"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#3D5AFE"
                        app:cornerRadius="8dp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_user_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="Nombre del usuario"
                    android:padding="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#808080"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_delete_user_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Eliminar"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#C62828"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save_user_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Guardar"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#3D5AFE"
                        app:cornerRadius="8dp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IDIOMAS"
                    android:textColor="#3D5AFE"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnLanguageEs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Español (Español)"
                    android:textColor="#3D5AFE"
                    android:backgroundTint="#2A2A2A"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnLanguageEn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Inglés (English)"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2A2A2A"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnLanguageRu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ruso (Русский)"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2A2A2A"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnLanguageZh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chino (中文)"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2A2A2A"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnLanguageKo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Coreano (한국어)"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2A2A2A"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnLanguageJa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Japonés (日本語)"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2A2A2A"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnLanguagePt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Portugués (Português)"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2A2A2A"
                    android:stateListAnimator="@null" />

                </LinearLayout>
            </ScrollView>

            <!-- ================= PAGE 1: DESCARGAS GGUF ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <ImageButton
                        android:id="@+id/btn_back_from_gguf_download"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_rounded_button"
                        android:src="@drawable/ic_back"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="MODELOS GGUF"
                        android:textColor="#3D5AFE"
                        android:textStyle="bold"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <EditText
                        android:id="@+id/et_gguf_url"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_rounded"
                        android:hint="URL del modelo (.gguf / .litertlm)"
                        android:padding="10dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#808080"
                        android:textSize="12sp"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:layout_marginEnd="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_gguf_url"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AÑADIR"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#3D5AFE"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_empty_gguf_downloads"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No hay descargas de modelos GGUF"
                    android:textColor="#808080"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="20dp" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/downloads_container_gguf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>

            <!-- ================= PAGE 2: DESCARGAS TTS ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <ImageButton
                        android:id="@+id/btn_back_from_tts_download"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_rounded_button"
                        android:src="@drawable/ic_back"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="VOCES TTS"
                        android:textColor="#3D5AFE"
                        android:textStyle="bold"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <EditText
                        android:id="@+id/et_tts_url"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_rounded"
                        android:hint="URL de la voz TTS (.onnx)"
                        android:padding="10dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#808080"
                        android:textSize="12sp"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:layout_marginEnd="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_tts_url"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AÑADIR"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#3D5AFE"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_empty_tts_downloads"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No hay descargas de voces TTS"
                    android:textColor="#808080"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="20dp" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/downloads_container_tts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>
        </ViewFlipper>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
