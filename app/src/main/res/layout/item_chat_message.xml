<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/messageContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp"
    android:gravity="center_vertical">

    <!-- Imagen de la IA (mostrar solo si es mensaje de la IA) -->
    <ImageView
        android:id="@+id/iv_ai_avatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_cumulus_diamond"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_circle_blue"
        android:padding="2dp"
        android:contentDescription="Avatar de la IA"
        android:visibility="gone" />

    <!-- Espacio entre la imagen y el texto -->
    <Space
        android:id="@+id/space_between"
        android:layout_width="8dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <!-- Contenido del mensaje -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvSender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#808080"
            android:paddingBottom="2dp"/>

        <TextView
            android:id="@+id/tvMessageContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:lineSpacingExtra="4dp"
            android:padding="12dp"
            android:maxWidth="300dp"/>

        <!-- Texto de "tokens" o detalles (para ponerlo debajo) -->
        <TextView
            android:id="@+id/tvTokenInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="11sp"
            android:textColor="#808080"/>
    </LinearLayout>

</LinearLayout>
