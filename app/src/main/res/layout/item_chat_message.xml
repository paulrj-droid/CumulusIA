<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/messageContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp"
    android:gravity="center_vertical">

    <!-- Imagen de la IA (mostrar solo si es mensaje de la IA) -->
    <ImageView
        android:id="@+id/iv_ai_avatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_cumulus_diamond"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_circle_blue"
        android:padding="2dp"
        android:contentDescription="Avatar de la IA"
        android:visibility="gone" />

    <!-- Espacio entre la imagen y el texto -->
    <Space
        android:id="@+id/space_between"
        android:layout_width="8dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <!-- Contenido del mensaje -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvSender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#808080"
            android:paddingBottom="2dp"/>

        <TextView
            android:id="@+id/tvMessageContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:lineSpacingExtra="4dp"
            android:padding="12dp"
            android:maxWidth="300dp"/>

        <!-- 📋 Botones de copiar código (uno por cada bloque ``` ) -->
        <LinearLayout
            android:id="@+id/codeActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:visibility="gone" />

        <!-- 📋 Copiar / 🔗 Compartir (solo en respuestas de la IA) -->
        <LinearLayout
            android:id="@+id/messageActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:layout_marginTop="2dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnCopyMessage"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_input_rounded"
                android:backgroundTint="#2C2C2E"
                android:text="📋 Copiar"
                android:textColor="#D0D0D0"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnShareMessage"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_input_rounded"
                android:backgroundTint="#2C2C2E"
                android:text="🔗 Compartir"
                android:textColor="#D0D0D0"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Texto de "tokens" o detalles (para ponerlo debajo) -->
        <TextView
            android:id="@+id/tvTokenInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="11sp"
            android:textColor="#808080"/>
    </LinearLayout>

</LinearLayout>

