<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <!-- PANTALLA PRINCIPAL (CHAT) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <ImageButton
                android:id="@+id/btn_open_left_drawer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_rounded_button"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="#FFFFFF" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_ai_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cumulus IA"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_open_right_drawer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_rounded_button"
                android:src="@android:drawable/ic_menu_preferences"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_chat_messages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="20dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/chat_composer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_input"
            android:minHeight="56dp"
            android:padding="8dp"
            android:layout_marginBottom="0dp"
            android:layout_marginTop="8dp">

            <ImageButton
                android:id="@+id/btn_voice_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@null"
                android:src="@android:drawable/ic_media_play"
                app:tint="#808080"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <EditText
                android:id="@+id/et_chat_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:background="@null"
                android:hint="Pregúntame..."
                android:textColor="#FFFFFF"
                android:textColorHint="#808080"
                android:textSize="16sp"
                android:gravity="top|start"
                android:paddingHorizontal="6dp"
                android:paddingVertical="8dp"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="6"
                android:scrollbars="vertical"
                app:layout_constraintStart_toEndOf="@id/btn_voice_play_pause"
                app:layout_constraintEnd_toStartOf="@id/btn_mic"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageButton
                android:id="@+id/btn_mic"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@null"
                android:src="@drawable/ic_mic"
                app:tint="#808080"
                app:layout_constraintEnd_toStartOf="@id/btn_send"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_blue"
                android:src="@android:drawable/ic_menu_send"
                app:tint="#FFFFFF"
                android:layout_marginStart="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <!-- PANEL IZQUIERDO (SERVICIOS Y CONTROL - LIMPIO SIN BURBUJA NI ACCESIBILIDAD) -->
    <ScrollView
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#1C1C1E">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SERVICIOS Y CONTROL"
                android:textColor="#00E676"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />

            <!-- Se removieron switch_floating_bubble, btn_choose_bubble_image y switch_accessibility_control -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_choose_voices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Elegir voz TTS"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2C2C2E"
                app:cornerRadius="8dp"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_authorized_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dar permisos de apps"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2E7D32"
                app:cornerRadius="12dp"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_blocked_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bloquear apps"
                android:textColor="#FFFFFF"
                android:backgroundTint="#C62828"
                app:cornerRadius="12dp"
                android:layout_marginBottom="20dp" />

            <!-- ==================== ELEVENLABS ==================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ELEVENLABS"
                android:textColor="#3D5AFE"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_eleven_api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_rounded"
                android:hint="API Key"
                android:padding="10dp"
                android:inputType="textPassword"
                android:textColor="#FFFFFF"
                android:textColorHint="#808080"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_eleven_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Guardar API Key"
                android:textColor="#FFFFFF"
                android:backgroundTint="#3D5AFE"
                app:cornerRadius="8dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_eleven_record"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Grabar"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2C2C2E"
                    app:cornerRadius="8dp" />

                <Space android:layout_width="8dp" android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_eleven_test"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Probar"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2C2C2E"
                    app:cornerRadius="8dp" />

                <Space android:layout_width="8dp" android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_eleven_use"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Usar"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#3D5AFE"
                    app:cornerRadius="8dp" />

                <Space android:layout_width="8dp" android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_eleven_delete"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Eliminar"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#C62828"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- PANEL DERECHO (CONFIGURACIÓN) -->
    <LinearLayout
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#1C1C1E">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
             android:text="CONFIGURACIÓN PRINCIPAL"
            android:textColor="#3D5AFE"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="12dp" />

         <TextView
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:text="Motor IA, personalidad, nombres e idiomas"
             android:textColor="#8A8A93"
             android:textSize="12sp"
             android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_gguf_downloads"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                    android:text="MODELOS GGUF / LITERT-LM"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:backgroundTint="#3D5AFE"
                app:cornerRadius="10dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_tts_downloads"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="VOCES TTS"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:backgroundTint="#2C2C2E"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <ViewFlipper
            android:id="@+id/settings_page_flipper"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:animateFirstView="false">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="40dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_model_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nombre del modelo"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2C2C2E"
                    app:cornerRadius="12dp"
                    android:layout_marginBottom="10dp" />

                <Spinner
                    android:id="@+id/spinner_backend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_rounded"
                    android:padding="10dp"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_backend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CPU / GPU / NPU"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2C2C2E"
                    app:cornerRadius="12dp"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_load_model"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cargar modelo"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#3D5AFE"
                    app:cornerRadius="12dp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tv_model_loaded_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Modelo: Ninguno"
                    android:textColor="#808080"
                    android:textSize="12sp"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONFIGURACIÓN DEL MODELO"
                    android:textColor="#3D5AFE"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONTEXTO"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seek_context"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="10000"
                    android:progress="7424" />

                <TextView
                    android:id="@+id/tv_context_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7424 tok"
                    android:textColor="#808080"
                    android:textSize="11sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TEMPERATURA"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seek_temperature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="70" />

                <TextView
                    android:id="@+id/tv_temperature_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.7"
                    android:textColor="#808080"
                    android:textSize="11sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOP K"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seek_top_k"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="40" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOP P"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seek_top_p"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="90" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PERSONALIDAD"
                    android:textColor="#3D5AFE"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_personality_general"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Asistente General"
                    android:textColor="#3D5AFE"
                    android:backgroundTint="#2A2A2A"
                    app:cornerRadius="8dp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_personality_programmer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Programador"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2A2A2A"
                    app:cornerRadius="8dp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_personality_creative"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Creativo"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2A2A2A"
                    app:cornerRadius="8dp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/et_personality_custom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="Escribe tu personalidad..."
                    android:padding="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#808080"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_custom_personality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="Guardar"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#3D5AFE"
                    app:cornerRadius="8dp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_delete_custom_personality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="Eliminar"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#C62828"
                    app:cornerRadius="8dp"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONFIGURACIÓN DE NOMBRES"
                    android:textColor="#3D5AFE"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/et_ai_name_custom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="Nombre de la IA"
                    android:padding="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#808080"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_ai_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Guardar nombre"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#3D5AFE"
                    app:cornerRadius="8dp"
                    android:layout_marginBottom="16dp" />

                <EditText
                    android:id="@+id/et_user_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="Nombre del usuario"
                    android:padding="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#808080"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_user_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Guardar usuario"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#3D5AFE"
                    app:cornerRadius="8dp"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IDIOMAS"
                    android:textColor="#3D5AFE"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnLanguageEs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Español (Español)"
                    android:textColor="#3D5AFE"
                    android:backgroundTint="#2A2A2A"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnLanguageEn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Inglés (English)"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2A2A2A"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnLanguageRu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ruso (Русский)"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2A2A2A"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnLanguageZh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chino (中文)"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2A2A2A"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnLanguageKo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Coreano (한국어)"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2A2A2A"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnLanguageJa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Japonés (日本語)"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2A2A2A"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnLanguagePt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Portugués (Português)"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2A2A2A"
                    android:stateListAnimator="@null" />

                </LinearLayout>
            </ScrollView>

            <include layout="@layout/layout_download_gguf" />
            <include layout="@layout/layout_download_tts" />
        </ViewFlipper>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
`[span_0](start_span)[span_0](end_span)

