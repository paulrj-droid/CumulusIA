<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permisos de Audio -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Permisos de Conectividad y Red necesarios para ElevenLabs y APIs externas -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Cámara en vivo: la IA mira tu entorno cuando le preguntas -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Descargas en segundo plano con progreso en la barra de notificaciones -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 📍 Ubicación (exacta o aproximada, la eliges tú): búsquedas en internet con tu comuna (micros, vuelos, empleos, cines,
         comida, hoteles, farmacias, arriendos, autos, el cielo…). Se pide solo al usarla, nunca en segundo plano -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".CumulusApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@style/Theme.CumulusIA">

        <!-- 🧠 IA de Google para separar personas y objetos del fondo (editor de imágenes) -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="subject_segment" />

        <!-- Bibliotecas opcionales usadas por LiteRT-LM para aceleración. -->
        <uses-native-library
            android:name="libvndksupport.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />

        <!-- Actividad Principal -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Permite abrir y compartir lo que crea la IA sin guardarlo en la galería -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 📥 Sigue descargando modelos y voces aunque salgas o cierres la app -->
        <service
            android:name=".manager.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Actividad temporal para mostrar errores/crashes en pantalla -->
        <activity
            android:name=".CrashActivity"
            android:exported="false" />

    </application>

</manifest>

